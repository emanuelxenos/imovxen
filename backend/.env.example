# ============================================================
# BACKEND API — VARIÁVEIS DE AMBIENTE
# ============================================================

PORT=8080
DATABASE_URL=postgres://imovxen_user:imovxen_pass@localhost:5432/imovxen?sslmode=disable
JWT_SECRET=imovxen-super-secret-jwt-key-2026-production-min32chars
JWT_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# Gateway de Pagamentos Asaas
ASAAS_API_KEY=
ASAAS_ENV=sandbox

# Serviço de E-mails Transacionais (SMTP)
# Se vazio, exibe log simulado no terminal
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=nao-responda@imovxen.com.br

# Storage S3 / MinIO Local (ou Cloudflare R2)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=imovxen-images
S3_PUBLIC_BASE_URL=http://localhost:9000/imovxen-images
S3_USE_PATH_STYLE=true
