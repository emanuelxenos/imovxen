# ==========================================
# IMOVXEN — VARIÁVEIS DE AMBIENTE LOCAIS
# ==========================================

# --- BANCO DE DADOS (POSTGRESQL) ---
POSTGRES_USER=imovxen_user
POSTGRES_PASSWORD=imovxen_pass
POSTGRES_DB=imovxen
POSTGRES_PORT=5432
DATABASE_URL=postgres://imovxen_user:imovxen_pass@localhost:5432/imovxen?sslmode=disable

# --- STORAGE S3 / MINIO ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=imovxen-images
S3_PUBLIC_BASE_URL=http://localhost:9000/imovxen-images
S3_USE_PATH_STYLE=true

# --- BACKEND (API GO) ---
PORT=8080
JWT_SECRET=super-secret-key-change-in-production-min32chars
JWT_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# --- FRONTEND (WEB SSR GO) ---
WEB_PORT=3000
BACKEND_URL=http://localhost:8080
SESSION_COOKIE_SECRET=session-secret-change-in-production-min32chars
ENVIRONMENT=development
